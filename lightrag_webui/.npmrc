# The WebUI is managed with Bun (`bun install --frozen-lockfile`); this file only
# exists so that environments which auto-detect a Node project and run `npm install`
# (e.g. cloud sandboxes) do not fail on ERESOLVE.
#
# eslint-plugin-react declares `peer eslint ^3..^9.7` and has no release that
# accepts eslint 10, while every other eslint consumer in package.json already
# accepts ^10. Bun installs this combination without complaint; npm 7+ refuses it
# unless told to fall back to npm 6 peer semantics.
legacy-peer-deps=true
